NODE_ENV=development            # development | test | production
PORT=5000
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/syncora?retryWrites=true&w=majority
# Local / Docker: mongodb://localhost:27017/syncora
MONGODB_URI=mongodb://localhost:27017/syncora
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
LOG_LEVEL=info                  # error | warn | info | http | debug
AUTH_RATE_LIMIT_MAX=10          # login/register attempts per 15 min per IP
REDIS_URL=                      # empty = caching off, e.g. redis://localhost:6379
