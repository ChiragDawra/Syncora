{
  "name": "syncora-server",
  "version": "1.0.0",
  "description": "Syncora REST API: Express + MongoDB (Mongoose) + JWT",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "seed": "node scripts/seed.js",
    "dev:memory": "node scripts/dev-memory.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.11",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
